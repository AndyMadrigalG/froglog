{
    "manifest_version": 3,
    "name": "FrogLog",
    "version": "1.1",
    "description": "Basic Extension to track and analyze user activity on the browser",
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icon.png"
    },
    "permissions": [
        "history",
        "tabs",
        "activeTab",
        "scripting"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
        "matches": ["<all_urls>"],
        "js": ["popup.js"]
        }
    ]
}